<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="user-grape-bubblegum" name="Grape Bubblegum" version="1.0">
  <color name="bg"            value="#45405A"/>
  <color name="gutter-bg"     value="#4F4967"/>
  <color name="bg-line"       value="#4F486A"/>
  <color name="bg-selection"  value="#726A95"/>
  <color name="fg"            value="#F8F8F2"/>
  <color name="cursor"        value="#F8F8F0"/>
  <color name="danger"        value="#FFB0B0"/>
  <color name="accent"        value="#ff9ed8"/>

  <style name="text"                 foreground="fg" background="bg"/>
  <style name="selection"            foreground="fg" background="bg-selection"/>
  <style name="cursor"               foreground="cursor"/>
  <style name="current-line"         background="bg-line"/>
  <style name="line-numbers"         foreground="auto" background="gutter-bg"/>
  <style name="current-line-number"  foreground="fg" background="bg-line"/>
  <style name="bracket-match"        foreground="fg" background="bg-selection" bold="true"/>
  <style name="bracket-mismatch"     foreground="danger" underline="single"/>
  <style name="notediff:accent"      foreground="accent"/>
</style-scheme>
